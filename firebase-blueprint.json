      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Trusted administrator directory."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Student user profiles and legal consent records."
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Published and draft courses."
    },
    "/courses/{courseId}/modules/{moduleId}": {
      "schema": { "$ref": "#/entities/CourseModule" },
      "description": "Modules belonging to a parent course."
    },
