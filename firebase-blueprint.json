    "/certificate_verifications/{certificateCode}": {
      "schema": { "$ref": "#/entities/CertificateVerification" },
      "description": "Public non-PII certificate verification lookup records."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "In-app notifications for students and administrators."
