    "/enrollment_requests/{requestId}": {
      "schema": { "$ref": "#/entities/EnrollmentRequest" },
      "description": "Course enrollment requests awaiting or resolved by admin approval."
    },
    "/student_enrollments/{enrollmentId}": {
      "schema": { "$ref": "#/entities/StudentEnrollment" },
      "description": "Authoritative enrollment and course progress records keyed as {studentId}_{courseId}."
    },
    "/assignment_submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/AssignmentSubmission" },
      "description": "Assignment submissions and admin evaluations keyed as {assignmentId}_{studentId}."
    },
    "/internships/{internshipId}": {
      "schema": { "$ref": "#/entities/Internship" },
      "description": "Internship programmes managed by admins."
    },
    "/internship_applications/{applicationId}": {
      "schema": { "$ref": "#/entities/InternshipApplication" },
      "description": "Student internship applications keyed as {internshipId}_{studentId}."
    },
    "/certificates/{certificateId}": {
      "schema": { "$ref": "#/entities/Certificate" },
      "description": "Issued student certificates."
