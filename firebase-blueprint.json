        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "slug", "name", "description", "orderIndex", "status", "createdAt", "updatedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Trusted administrator account record controlling elevated portal privileges.",
