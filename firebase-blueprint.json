      "schema": { "$ref": "#/entities/Quiz" },
      "description": "Course module quizzes and final assessments."
    },
    "/courses/{courseId}/quizzes/{quizId}/questions/{questionId}": {
      "schema": { "$ref": "#/entities/QuizQuestion" },
      "description": "Quiz multiple-choice questions and explanations."
    },
    "/courses/{courseId}/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/Assignment" },
      "description": "Course assignments accessible only to enrolled students and admins."
    },
    "/quiz_attempts/{attemptId}": {
      "schema": { "$ref": "#/entities/QuizAttempt" },
      "description": "Student quiz and AI practice test attempts with weak-topic analytics."
    },
    "/saved_ai_notes/{noteId}": {
      "schema": { "$ref": "#/entities/SavedAiNote" },
      "description": "Personal AI-generated study notes saved by enrolled students."
    },
    "/ai_tutor_sessions/{sessionId}": {
